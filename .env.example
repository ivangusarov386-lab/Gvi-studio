# Demo uses synthetic data. No credentials are needed.
HOST=127.0.0.1
PORT=3000
GTO_MODE=demo
# For an approved live connection only; absolute paths outside the checkout:
# GTO_MODE=sheets
# GTO_CONFIG_PATH=/secure/gto-source.json
# GOOGLE_APPLICATION_CREDENTIALS=/secure/service-account.json
